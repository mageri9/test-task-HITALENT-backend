# PostgreSQL settings
POSTGRES_USER=org_user
POSTGRES_PASSWORD=org_pass
POSTGRES_DB=org_structure
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Main application database
DATABASE_URL=postgresql+psycopg2://org_user:org_pass@db:5432/org_structure

# Test database
TEST_DATABASE_URL=postgresql+psycopg2://org_user:org_pass@db:5432/org_structure_test